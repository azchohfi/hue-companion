<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueCompanion.Controls.LightCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueCompanion.Controls"
    xmlns:vm="using:HueCompanion.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="CardRoot_PointerEntered"
    PointerExited="CardRoot_PointerExited">

    <Grid x:Name="OuterContainer">
        <VisualStateManager.VisualStateGroups>
            <!-- HoverStates handled in code-behind for theme-aware colors -->
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="Hover"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main card container -->
        <Grid x:Name="CardRoot"
              CornerRadius="16"
              MinHeight="120"
              Tapped="CardRoot_Tapped">
            <!-- Background set in code-behind for theme-aware gradients -->

            <!-- Colored outline borders - two for cross-fade animation -->
            <Border x:Name="OutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="OutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- Content -->
            <Grid Canvas.ZIndex="1" Margin="16">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="ContextMenu_Opening">
                        <MenuFlyoutItem Text="Identify"
                                        Click="Identify_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Copy color"
                                        Click="CopyColor_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PasteColorMenuItem"
                                        Text="Paste color"
                                        Click="PasteColor_Click"
                                        Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="AddToDashboardMenuItem"
                                        Text="Add to Dashboard"
                                        Click="AddToDashboard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE728;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutSubItem x:Name="MoveToRoomSubMenu" Text="Move to room...">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8DE;"/>
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Name="AddToZoneSubMenu" Text="Add to zone...">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE710;"/>
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Name="RemoveFromZoneSubMenu" Text="Remove from zone...">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE738;"/>
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: Icon + Name + Brightness -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon container -->
                    <Border x:Name="IconContainer"
                            Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{ThemeResource CardIconBackgroundBrush}">
                        <FontIcon x:Name="LightIcon"
                                  Glyph="&#xE781;"
                                  FontSize="18"
                                  Foreground="{ThemeResource CardIconForegroundBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name and color mode -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LightNameText"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource CardPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ColorModeText" FontSize="12"
                                   Foreground="{ThemeResource CardTertiaryTextBrush}"
                                   Text="{Binding ColorModeLabel}"
                                   Margin="0,2,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- Brightness slider row -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BrightnessSlider"
                            Minimum="0" Maximum="100"
                            MinHeight="24" Height="24" Padding="0"
                            Value="{Binding BrightnessPercent, Mode=OneWay}"
                            ValueChanged="BrightnessSlider_ValueChanged"
                            IsEnabled="{Binding IsOn}">
                        <Slider.Resources>
                            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
                            <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>
                        </Slider.Resources>
                    </Slider>
                    <TextBlock Grid.Column="1" FontSize="11" MinWidth="28"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource CardSecondaryTextBrush}" Margin="6,0,0,0">
                        <Run Text="{Binding BrightnessPercent}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>

                <!-- Bottom row: Color button + Toggle -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Color SplitButton -->
                    <SplitButton x:Name="ColorSplitButton"
                                 Grid.Column="0"
                                 Style="{StaticResource ColorSplitButtonStyle}"
                                 VerticalAlignment="Center"
                                 MinHeight="32"
                                 Visibility="{Binding SupportsColor}">
                        <Border x:Name="ColorButtonContent" CornerRadius="7,0,0,7"
                                Background="Transparent"
                                Margin="-16,-16,-8,-16"
                                Padding="16,0">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                        <SplitButton.Flyout>
                            <Flyout x:Name="ColorPickerFlyout"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False"
                                    Opening="ColorPickerFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <local:ColorPickerFlyout x:Name="ColorFlyout" ColorChanged="ColorFlyout_ColorChanged"/>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Toggle switch -->
                    <ToggleSwitch x:Name="LightToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource GradientToggleSwitchStyle}"
                                  IsOn="{Binding IsOn, Mode=TwoWay}"
                                  Tapped="LightToggle_Tapped"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
