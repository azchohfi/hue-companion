<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueCompanion.Controls.IconPickerFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" CornerRadius="12" Padding="16" Width="280"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <StackPanel Spacing="12">
            <!-- Header -->
            <TextBlock Text="Choose Icon"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <!-- Icon Grid -->
            <GridView x:Name="IconGrid"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="IconGrid_ItemClick"
                      MaxHeight="320">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <!-- Reset Button -->
            <Button x:Name="ResetButton"
                    Content="Reset to Default"
                    HorizontalAlignment="Stretch"
                    Click="ResetButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
