<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueCompanion.Views.ZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueCompanion.Views"
    xmlns:vm="using:HueCompanion.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Zones"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <ToggleButton x:Name="EditToggle"
                          Grid.Column="1"
                          VerticalAlignment="Top"
                          ToolTipService.ToolTip="Edit zone membership"
                          IsChecked="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                          Margin="0,0,8,0"
                          Style="{StaticResource IconToggleButtonStyle}">
                <FontIcon Glyph="&#xE70F;" FontSize="16"/>
            </ToggleButton>

            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading zones..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Zone Sections -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36" Spacing="24">

                <!-- Error Message -->
                <InfoBar IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True"/>

                <!-- Edit Mode Banner -->
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="16,10"
                        Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Drag lights between zones to reassign them"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Zone Sections Repeater -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ZoneSections, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="20"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneSectionViewModel">
                            <StackPanel AllowDrop="True"
                                        DragOver="ZoneSection_DragOver"
                                        Drop="ZoneSection_Drop"
                                        Tag="{x:Bind}">

                                <!-- Zone Heading Row -->
                                <Grid Margin="0,0,0,8"
                                      Tapped="ZoneHeading_Tapped"
                                      Tag="{x:Bind}"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind IconGlyph}"
                                              FontSize="18"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Border Grid.Column="2"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:ZonesPage.FormatLightCount(LightCount)}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontSize="11"/>
                                    </Border>

                                    <ToggleSwitch Grid.Column="4"
                                                  IsOn="{x:Bind IsOn, Mode=OneWay}"
                                                  Toggled="ZoneToggle_Toggled"
                                                  Tag="{x:Bind}"
                                                  OnContent="" OffContent=""
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Separator -->
                                <Border Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Lights in this zone -->
                                <ItemsRepeater ItemsSource="{x:Bind Lights}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="2"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ZoneLightItemViewModel">
                                            <Grid Height="36"
                                                  Padding="8,0"
                                                  CornerRadius="6"
                                                  Background="Transparent"
                                                  PointerEntered="LightItem_PointerEntered"
                                                  PointerExited="LightItem_PointerExited"
                                                  Tapped="LightItem_Tapped"
                                                  CanDrag="{Binding ElementName=EditToggle, Path=IsChecked}"
                                                  DragStarting="LightItem_DragStarting"
                                                  Tag="{x:Bind}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Color Dot -->
                                                <Ellipse Grid.Column="0"
                                                         Width="10" Height="10"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{x:Bind local:ZonesPage.GetLightDotColor(IsOn, ColorRgb)}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <!-- Light Name + Room Name -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center"
                                                            Opacity="{x:Bind local:ZonesPage.GetLightOpacity(IsOn)}">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind RoomName}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind local:ZonesPage.HasRoomName(RoomName)}"/>
                                                </StackPanel>

                                                <!-- Remove Button (edit mode only) -->
                                                <Button Grid.Column="3"
                                                        Visibility="{Binding ElementName=EditToggle, Path=IsChecked}"
                                                        Click="RemoveFromZone_Click"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Remove from zone">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Unassigned Section -->
                <StackPanel Visibility="{x:Bind HasUnassigned(ViewModel.UnassignedSection), Mode=OneWay}"
                            AllowDrop="True"
                            DragOver="UnassignedSection_DragOver"
                            Drop="UnassignedSection_Drop">

                    <!-- Unassigned Heading -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE8CB;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Unassigned Lights"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Border Grid.Column="2"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FormatUnassignedCount(ViewModel.UnassignedSection), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontSize="11"/>
                        </Border>
                    </Grid>

                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,0,0,8"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UnassignedSection.Lights, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ZoneLightItemViewModel">
                                <Grid Height="36"
                                      Padding="8,0"
                                      CornerRadius="6"
                                      Background="Transparent"
                                      PointerEntered="LightItem_PointerEntered"
                                      PointerExited="LightItem_PointerExited"
                                      Tapped="LightItem_Tapped"
                                      CanDrag="{Binding ElementName=EditToggle, Path=IsChecked}"
                                      DragStarting="LightItem_DragStarting"
                                      Tag="{x:Bind}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind local:ZonesPage.GetLightDotColor(IsOn, ColorRgb)}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center"
                                                Opacity="{x:Bind local:ZonesPage.GetLightOpacity(IsOn)}">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind RoomName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind local:ZonesPage.HasRoomName(RoomName)}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.HasZones), Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="360">

            <FontIcon Glyph="&#xE8F1;"
                      Style="{StaticResource EmptyStateIconStyle}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="No zones found"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Zones let you group lights across different rooms. For example, create a 'Downstairs' zone to control all ground floor lights together."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="Open Hue App"
                        Click="OpenHueApp_Click"/>
                <Button Content="Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.LoadCommand}"/>
            </StackPanel>

            <HyperlinkButton Content="Learn about zones"
                             NavigateUri="https://www.philips-hue.com/en-us/explore-hue/how-to/create-zones"
                             HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
