<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueCompanion.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueCompanion.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interfaces="using:HueCompanion.Core.Services.Interfaces"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="40">
        <StackPanel MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">

            <!-- Header -->
            <FontIcon Glyph="&#xE781;"
                      FontSize="64"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <TextBlock Text="Connect to Hue Bridge"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       Opacity="0.8"/>

            <!-- Discovery Progress -->
            <ProgressRing x:Name="DiscoveryProgress"
                          IsActive="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"/>

            <!-- Search Button -->
            <Button Content="Search for Bridges"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.DiscoverBridgesCommand}"
                    Visibility="{x:Bind InvertBool(ViewModel.IsDiscovering), Mode=OneWay}"/>

            <!-- Discovered Bridges List -->
            <ListView x:Name="BridgesList"
                      ItemsSource="{x:Bind ViewModel.DiscoveredBridges, Mode=OneWay}"
                      SelectionMode="None"
                      MaxHeight="200"
                      Margin="0,16,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="interfaces:DiscoveredBridge">
                        <Grid Padding="12"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="8"
                              Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE968;"
                                      FontSize="24"
                                      Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Hue Bridge"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind IpAddress}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.7"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Connect"
                                    Tag="{x:Bind}"
                                    Click="ConnectBridge_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Link Button Prompt -->
            <StackPanel x:Name="LinkButtonPanel"
                        Visibility="{x:Bind ViewModel.ShowLinkButtonPrompt, Mode=OneWay}"
                        Spacing="16"
                        HorizontalAlignment="Center">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="32"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE8B5;"
                                  FontSize="48"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                        <TextBlock Text="Press the link button on your Hue Bridge"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextAlignment="Center"/>

                        <TextBlock Text="The button is the large circular button on top of the bridge"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextAlignment="Center"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <Button Content="Connect"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        Command="{x:Bind ViewModel.RegisterWithBridgeCommand}"/>
            </StackPanel>

            <!-- Registration Progress -->
            <StackPanel x:Name="RegistrationPanel"
                        Visibility="{x:Bind ViewModel.IsRegistering, Mode=OneWay}"
                        Spacing="16"
                        HorizontalAlignment="Center">

                <ProgressRing IsActive="True" Width="48" Height="48"/>

                <TextBlock Text="Waiting for link button press..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"/>

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           TextAlignment="Center"
                           Opacity="0.7">
                    <Run Text="Time remaining: "/>
                    <Run Text="{x:Bind ViewModel.LinkButtonCountdown, Mode=OneWay}"/>
                    <Run Text="s"/>
                </TextBlock>

                <Button Content="Cancel"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CancelRegistrationCommand}"/>
            </StackPanel>

            <!-- Success State -->
            <StackPanel Visibility="{x:Bind ViewModel.RegistrationSuccess, Mode=OneWay}"
                        Spacing="16"
                        HorizontalAlignment="Center">

                <FontIcon Glyph="&#xE73E;"
                          FontSize="64"
                          Foreground="Green"
                          HorizontalAlignment="Center"/>

                <TextBlock Text="Connected!"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
