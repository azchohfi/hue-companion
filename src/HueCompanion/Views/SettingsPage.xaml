<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueCompanion.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueCompanion.Views"
    xmlns:models="using:HueCompanion.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="36,32,36,36" Spacing="28" MaxWidth="1000" HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Settings"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Customize your experience"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <!-- Theme Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Select which app theme to display"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              SelectedIndex="{x:Bind GetThemeIndex(ViewModel.SelectedTheme), Mode=OneWay}"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              MinWidth="160"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Use system setting"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Hotkey Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Global Hotkey"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <!-- Enable/Disable Toggle -->
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="20" Margin="0,0,16,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Enable global hotkey"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Show/hide window with a keyboard shortcut"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2"
                                  IsOn="{x:Bind ViewModel.IsHotkeyEnabled, Mode=TwoWay}"
                                  OnContent="On"
                                  OffContent="Off"
                                  VerticalAlignment="Center"/>
                </Grid>

                <!-- Hotkey Configuration -->
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16"
                      Visibility="{x:Bind ViewModel.IsHotkeyEnabled, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modifiers -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Modifier keys"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Win"
                                      IsChecked="{x:Bind ViewModel.HasWinModifier, Mode=TwoWay}"/>
                            <CheckBox Content="Ctrl"
                                      IsChecked="{x:Bind ViewModel.HasCtrlModifier, Mode=TwoWay}"/>
                            <CheckBox Content="Alt"
                                      IsChecked="{x:Bind ViewModel.HasAltModifier, Mode=TwoWay}"/>
                            <CheckBox Content="Shift"
                                      IsChecked="{x:Bind ViewModel.HasShiftModifier, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Key Selection -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="Key"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <ComboBox x:Name="KeyComboBox"
                                  MinWidth="120"
                                  ItemsSource="{x:Bind AvailableHotkeyKeys}"
                                  SelectedItem="{x:Bind ViewModel.SelectedKey, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:VirtualKey">
                                    <TextBlock Text="{x:Bind local:SettingsPage.GetKeyDisplayNameStatic((models:VirtualKey))}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Current Hotkey Display and Status -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current hotkey:"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,4">
                                <TextBlock Text="{x:Bind ViewModel.HotkeyDisplayString, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="{x:Bind GetStatusIcon(ViewModel.IsHotkeyError), Mode=OneWay}"
                                      FontSize="12"
                                      Foreground="{x:Bind GetStatusColor(ViewModel.IsHotkeyError), Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.HotkeyStatusMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{x:Bind GetStatusColor(ViewModel.IsHotkeyError), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- System Tray Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="System Tray"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Minimize to Tray -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE921;" FontSize="20" Margin="0,0,16,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Minimize to system tray"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Hide to tray when minimizing instead of taskbar"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start Minimized -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="20" Margin="0,0,16,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start minimized"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Launch app minimized to system tray"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- Bridge Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Hue Bridge"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE968;" FontSize="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Hue Bridge"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border CornerRadius="4"
                                    Padding="6,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{x:Bind GetMultiBridgeConnectionColor(ViewModel.ConnectedBridgeCount), Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind GetMultiBridgeConnectionStatus(ViewModel.BridgeCount, ViewModel.ConnectedBridgeCount), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind GetBridgeCountText(ViewModel.BridgeCount), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Manage Bridges"
                                Command="{x:Bind ViewModel.ManageBridgesCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="About"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="8"
                            Background="#25FFFFFF"
                            Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE781;" FontSize="24"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Hue Windows"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Version "/>
                            <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="A modern Philips Hue controller for Windows"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
