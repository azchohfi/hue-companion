<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueCompanion.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueCompanion.Views"
    xmlns:controls="using:HueCompanion.Controls"
    xmlns:vm="using:HueCompanion.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Home"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Control your Hue lights"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button ToolTipService.ToolTip="Add Room or Zone"
                        Click="AddRoomOrZone_Click"
                        Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </Button>
                <Button ToolTipService.ToolTip="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Room and Zone Cards -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36" Spacing="24">

                <!-- Rooms Section -->
                <StackPanel Visibility="{x:Bind ViewModel.HasRooms, Mode=OneWay}">
                    <TextBlock Text="Rooms"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>
                    <ItemsRepeater x:Name="RoomCardsRepeater"
                                   ItemsSource="{x:Bind ViewModel.RoomCards, Mode=OneWay}"
                                   ElementPrepared="CardsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinItemHeight="120"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomCardViewModel">
                                <controls:RoomCard DataContext="{x:Bind}">
                                    <controls:RoomCard.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Add to Dashboard"
                                                            Click="AddToDashboard_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE728;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </controls:RoomCard.ContextFlyout>
                                </controls:RoomCard>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Zones Section -->
                <StackPanel Visibility="{x:Bind ViewModel.HasZones, Mode=OneWay}">
                    <TextBlock Text="Zones"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>
                    <ItemsRepeater x:Name="ZoneCardsRepeater"
                                   ItemsSource="{x:Bind ViewModel.ZoneCards, Mode=OneWay}"
                                   ElementPrepared="CardsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinItemHeight="120"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomCardViewModel">
                                <controls:RoomCard DataContext="{x:Bind}">
                                    <controls:RoomCard.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Add to Dashboard"
                                                            Click="AddToDashboard_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE728;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </controls:RoomCard.ContextFlyout>
                                </controls:RoomCard>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="360">

            <FontIcon Glyph="&#xE781;"
                      Style="{StaticResource EmptyStateIconStyle}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="No rooms or zones found"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your Hue bridge is connected but doesn't have any rooms configured yet. Create a room to organize your lights."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="Create Room"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddRoomOrZone_Click"/>
                <Button Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"/>
            </StackPanel>

            <HyperlinkButton Content="Learn how to set up rooms"
                             NavigateUri="https://www.philips-hue.com/en-us/explore-hue/how-to/create-rooms"
                             HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error Message -->
        <InfoBar Grid.Row="1"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
