<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueWindows.Controls.Win2DGlowPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False">

    <!-- 
    Win2DGlowPanel: A pure Win2D implementation of gaussian blur glow effects.
    Uses CanvasControl directly for maximum quality and flexibility.
    
    Key differences from Composition API approach:
    - Direct Win2D rendering pipeline (no intermediate surfaces)
    - CanvasControl handles device management automatically
    - Simpler animation model using opacity on the control
    - Better support for complex gradient glows
    -->
    <Grid x:Name="RootGrid">
        <canvas:CanvasControl x:Name="GlowCanvas"
                              Draw="GlowCanvas_Draw"
                              CreateResources="GlowCanvas_CreateResources"/>
    </Grid>
</UserControl>
