<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueWindows.Controls.LightCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="CardRoot_PointerEntered"
    PointerExited="CardRoot_PointerExited">

    <Grid x:Name="OuterContainer">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="Hover">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF222226" Offset="0"/>
                                    <GradientStop Color="#FF2D2D30" Offset="0.5"/>
                                    <GradientStop Color="#FF262629" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main card container -->
        <Grid x:Name="CardRoot"
              CornerRadius="8"
              PointerPressed="CardRoot_PointerPressed">

            <!-- Dark gradient background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1E" Offset="0"/>
                    <GradientStop Color="#FF252528" Offset="0.5"/>
                    <GradientStop Color="#FF1E1E22" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Colored outline borders - two for cross-fade animation -->
            <Border x:Name="OutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="OutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- Content with margin instead of padding on parent -->
            <Grid Canvas.ZIndex="1" Margin="16,12">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="AddToDashboardMenuItem"
                                        Text="Add to Dashboard"
                                        Click="AddToDashboard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE728;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon container -->
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="18"
                        Background="#20FFFFFF"
                        Margin="0,0,14,0">
                    <FontIcon x:Name="LightIcon"
                              Glyph="&#xE781;"
                              FontSize="16"
                              Foreground="#80FFFFFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!-- Name and brightness -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="LightNameText"
                               Text="{Binding Name}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding BrightnessPercent}"/>
                        <Run Text="% brightness"/>
                    </TextBlock>
                </StackPanel>

                <!-- Toggle switch -->
                <ToggleSwitch x:Name="LightToggle"
                              Grid.Column="2"
                              Style="{StaticResource GradientToggleSwitchStyle}"
                              IsOn="{Binding IsOn, Mode=TwoWay}"
                              Tapped="LightToggle_Tapped"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
