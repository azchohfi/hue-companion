<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueWindows.Controls.LightCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="CardRoot_PointerEntered"
    PointerExited="CardRoot_PointerExited">

    <Grid x:Name="OuterContainer">
        <VisualStateManager.VisualStateGroups>
            <!-- HoverStates handled in code-behind for theme-aware colors -->
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="Hover"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main card container -->
        <Grid x:Name="CardRoot"
              CornerRadius="16"
              MinHeight="120"
              Tapped="CardRoot_Tapped">
            <!-- Background set in code-behind for theme-aware gradients -->
            <Grid.Shadow>
                <ThemeShadow BlurRadius="20" Opacity="0.3"/>
            </Grid.Shadow>

            <Grid x:Name="LightingEffects" CornerRadius="16" IsHitTestVisible="False">
                <Border CornerRadius="16" Margin="1" Opacity="0.7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource CardInnerHighlightColor}" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                            <GradientStop Color="{ThemeResource CardInnerShadowColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="16" Margin="1" Opacity="0.6">
                    <Border.Background>
                        <RadialGradientBrush Center="0,0" RadiusX="1" RadiusY="1">
                            <GradientStop Color="{ThemeResource CardCornerGlowColor}" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="16" Margin="1" Opacity="0.55">
                    <Border.Background>
                        <RadialGradientBrush Center="1,1" RadiusX="1" RadiusY="1">
                            <GradientStop Color="{ThemeResource CardCornerShadowColor}" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="16" Margin="1" BorderThickness="1" Opacity="0.55">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource CardEdgeGlowColor}" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                            <GradientStop Color="{ThemeResource CardInnerShadowColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>
            </Grid>

            <!-- Colored outline borders - two for cross-fade animation -->
            <Border x:Name="OutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="OutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- Content -->
            <Grid Canvas.ZIndex="1" Margin="16">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="AddToDashboardMenuItem"
                                        Text="Add to Dashboard"
                                        Click="AddToDashboard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE728;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: Icon + Name + Brightness -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon container -->
                    <Border x:Name="IconContainer"
                            Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{ThemeResource CardIconBackgroundBrush}">
                        <Grid>
                            <Border x:Name="IconGlow"
                                    CornerRadius="20"
                                    Background="Transparent"
                                    Opacity="0.7"/>
                            <FontIcon x:Name="LightIcon"
                                      Glyph="&#xE781;"
                                      FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Name and brightness -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LightNameText"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource CardPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource CardSecondaryTextBrush}"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding BrightnessPercent}"/>
                            <Run Text="% brightness"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Middle spacer -->
                <Grid Grid.Row="1"/>

                <!-- Bottom row: Color button + Toggle -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Color SplitButton -->
                    <SplitButton x:Name="ColorSplitButton"
                                 Grid.Column="0"
                                 Style="{StaticResource ColorSplitButtonStyle}"
                                 VerticalAlignment="Center"
                                 MinHeight="32"
                                 Visibility="{Binding SupportsColor}">
                        <Border x:Name="ColorButtonContent" CornerRadius="7,0,0,7"
                                Background="Transparent"
                                Margin="-16,-16,-8,-16"
                                Padding="16,0">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                        <SplitButton.Flyout>
                            <Flyout x:Name="ColorPickerFlyout"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False"
                                    Opening="ColorPickerFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <local:ColorPickerFlyout x:Name="ColorFlyout" ColorChanged="ColorFlyout_ColorChanged"/>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Toggle switch -->
                    <ToggleSwitch x:Name="LightToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource GradientToggleSwitchStyle}"
                                  IsOn="{Binding IsOn, Mode=TwoWay}"
                                  Tapped="LightToggle_Tapped"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
