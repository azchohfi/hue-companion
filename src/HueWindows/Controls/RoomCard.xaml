<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueWindows.Controls.RoomCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="CardRoot_PointerEntered"
    PointerExited="CardRoot_PointerExited">

    <Grid x:Name="OuterContainer">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ActiveStates">
                <!-- No transitions - border opacity animated manually in code-behind -->
                <!-- Icon foreground is set in code-behind via UpdateIconColor() to match room's light colors -->
                <VisualState x:Name="Inactive"/>
                <VisualState x:Name="Active"/>
            </VisualStateGroup>

            <!-- HoverStates handled in code-behind for theme-aware colors -->
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="Hover"/>
            </VisualStateGroup>

            <VisualStateGroup x:Name="DragStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="Dragging"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Colored glow layer behind the card -->
        <Border x:Name="GlowBorder"
                CornerRadius="20"
                Margin="-4"
                Opacity="0"
                IsHitTestVisible="False"/>

        <!-- Main card container -->
        <Grid x:Name="CardRoot"
              CornerRadius="16"
              MinHeight="120"
              RenderTransformOrigin="0.5,0.5"
              ManipulationMode="TranslateY"
              ManipulationStarted="CardRoot_ManipulationStarted"
              ManipulationDelta="CardRoot_ManipulationDelta"
              ManipulationCompleted="CardRoot_ManipulationCompleted"
              Tapped="CardRoot_Tapped">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <!-- Background set in code-behind for theme-aware gradients -->

            <!-- Solid Outline Border - Moved here for valid XAML structure (after properties) -->
            <Border x:Name="OutlineBorder"
                    Canvas.ZIndex="0"
                    Grid.RowSpan="3"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- Padded Content Wrapper -->
            <!-- ZIndex 1 ensures it's above the border -->
            <Grid Margin="16" Canvas.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Icon and Name -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon container with circular background -->
                    <Border x:Name="IconContainer"
                            Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{ThemeResource CardIconBackgroundBrush}">
                        <FontIcon x:Name="RoomIcon"
                                  Glyph="{Binding RoomIcon}"
                                  FontSize="18"
                                  Foreground="{ThemeResource CardIconForegroundBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RoomNameText"
                                   Text="{Binding RoomName}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource CardPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LightCountText"
                                   FontSize="12"
                                   Foreground="{ThemeResource CardSecondaryTextBrush}"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding LightCount}"/>
                            <Run Text=" lights"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Middle spacer for drag gesture -->
                <Grid Grid.Row="1"/>

                <!-- Bottom: Toggle and Brightness -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toggle switch -->
                    <ToggleSwitch x:Name="RoomToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource GradientToggleSwitchStyle}"
                                  IsOn="{Binding IsOn, Mode=TwoWay}"
                                  Tapped="RoomToggle_Tapped"
                                  VerticalAlignment="Center"/>

                    <!-- Brightness bar -->
                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="8,0,12,0"
                          Height="4">
                        <!-- Track background -->
                        <Border Background="{ThemeResource CardTrackBackgroundBrush}"
                                CornerRadius="2"/>
                        <!-- Fill indicator -->
                        <Border x:Name="BrightnessFill"
                                Background="{ThemeResource CardTrackFillBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Brightness percentage -->
                    <TextBlock x:Name="BrightnessText"
                               Grid.Column="2"
                               FontSize="12"
                               Foreground="{ThemeResource CardTertiaryTextBrush}"
                               VerticalAlignment="Center"
                               MinWidth="36"
                               TextAlignment="Right">
                        <Run Text="{Binding BrightnessPercent}"/>
                        <Run Text=" %"/>
                    </TextBlock>
                </Grid>

                <!-- Scene chips row -->
                <StackPanel x:Name="SceneChipsPanel" Grid.Row="3"
                            Orientation="Horizontal" Spacing="4" Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="SceneChip0" MinHeight="24" MaxHeight="24"
                            Padding="8,2" CornerRadius="12" BorderThickness="0"
                            Click="SceneChip_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse x:Name="SceneChip0Dot" Width="8" Height="8"/>
                            <TextBlock x:Name="SceneChip0Text" FontSize="11"
                                       MaxWidth="56" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource CardPrimaryTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SceneChip1" MinHeight="24" MaxHeight="24"
                            Padding="8,2" CornerRadius="12" BorderThickness="0"
                            Click="SceneChip_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse x:Name="SceneChip1Dot" Width="8" Height="8"/>
                            <TextBlock x:Name="SceneChip1Text" FontSize="11"
                                       MaxWidth="56" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource CardPrimaryTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SceneChip2" MinHeight="24" MaxHeight="24"
                            Padding="8,2" CornerRadius="12" BorderThickness="0"
                            Click="SceneChip_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse x:Name="SceneChip2Dot" Width="8" Height="8"/>
                            <TextBlock x:Name="SceneChip2Text" FontSize="11"
                                       MaxWidth="56" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource CardPrimaryTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreScenesButton" MinHeight="24" MaxHeight="24"
                            Padding="6,2" CornerRadius="12" BorderThickness="0"
                            Background="{ThemeResource CardIconBackgroundBrush}"
                            Visibility="Collapsed">
                        <FontIcon Glyph="&#xE712;" FontSize="10"
                                  Foreground="{ThemeResource CardSecondaryTextBrush}"/>
                        <Button.Flyout>
                            <Flyout x:Name="AllScenesFlyout" Placement="Bottom"
                                    ShouldConstrainToRootBounds="False"
                                    Opening="AllScenesFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="8"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                        <Setter Property="MaxHeight" Value="320"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel x:Name="ScenesFlyoutContent" Width="200"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            

        </Grid>


    </Grid>
</UserControl>
