<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HueWindows.Controls.RoomCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="CardRoot_PointerEntered"
    PointerExited="CardRoot_PointerExited">

    <Grid x:Name="CardRoot"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="16,14,16,16"
          PointerPressed="CardRoot_PointerPressed"
          PointerMoved="CardRoot_PointerMoved"
          PointerReleased="CardRoot_PointerReleased"
          PointerCaptureLost="CardRoot_PointerCaptureLost"
          Tapped="CardRoot_Tapped">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Icon, Name, Toggle -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <FontIcon x:Name="RoomIcon"
                          Glyph="{x:Bind ViewModel.RoomIcon, Mode=OneWay}"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.RoomName, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.LightCount, Mode=OneWay}"/>
                    <Run Text=" lights"/>
                </TextBlock>
            </StackPanel>

            <ToggleSwitch Grid.Column="2"
                          IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="0"
                          Margin="8,0,0,0"/>
        </Grid>

        <!-- Center spacer / drag area hint -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <TextBlock x:Name="DragHintText"
                       Text="Drag to adjust"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Brightness Bar and Info -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brightness Progress Bar -->
            <ProgressBar Grid.Column="0"
                         x:Name="BrightnessBar"
                         Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"
                         Maximum="100"
                         Height="4"
                         CornerRadius="2"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>

            <!-- Brightness Percentage -->
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       MinWidth="32"
                       TextAlignment="Right">
                <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                <Run Text="%"/>
            </TextBlock>
        </Grid>

        <!-- Visual state indicator for "on" state -->
        <Border x:Name="OnStateBorder"
                Grid.RowSpan="3"
                CornerRadius="8"
                BorderThickness="1"
                IsHitTestVisible="False"
                Opacity="0"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OnOffStates">
                <VisualState x:Name="Off"/>
                <VisualState x:Name="On">
                    <VisualState.Setters>
                        <Setter Target="OnStateBorder.Opacity" Value="1"/>
                        <Setter Target="RoomIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Default"/>
                <VisualState x:Name="Hover">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="DragStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="Dragging">
                    <VisualState.Setters>
                        <Setter Target="DragHintText.Opacity" Value="0.8"/>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
