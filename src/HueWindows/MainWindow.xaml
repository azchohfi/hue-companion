<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HueWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows"
    xmlns:views="using:HueWindows.Views"
    Title="Hue Companion">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pane Toggle Button -->
            <Button x:Name="PaneToggleButton"
                    Grid.Column="0"
                    Style="{StaticResource PaneToggleButtonStyle}"
                    Width="40" Height="32"
                    Click="PaneToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="16"/>
            </Button>

            <!-- Back Button -->
            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Width="40" Height="32"
                    Visibility="{x:Bind CanGoBack, Mode=OneWay}"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Button>

            <!-- App Icon -->
            <Image Grid.Column="2" Source="Assets/Square44x44Logo.png" Width="18" Height="18" Margin="8,0,8,0"
                   VerticalAlignment="Center"/>

            <!-- Title -->
            <TextBlock x:Name="TitleTextBlock" Grid.Column="3"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            PaneOpened="NavView_PaneOpened"
            PaneClosed="NavView_PaneClosed"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsPaneOpen="False"
            IsTabStop="False"
            IsTitleBarAutoPaddingEnabled="False">

            <NavigationView.MenuItems>
                <!-- My Dashboard (pinned items) - hidden when empty -->
                <NavigationViewItem x:Name="MyDashboardNavItem" Content="My Dashboard" Tag="MyDashboard" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE728;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Dashboard (all rooms/zones) -->
                <NavigationViewItem x:Name="DashboardNavItem" Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Zones -->
                <NavigationViewItem x:Name="ZonesNavItem" Content="Zones" Tag="Zones">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC26;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Rooms -->
                <NavigationViewItem x:Name="RoomsNavItem" Content="Rooms" Tag="Rooms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBC6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Scenes -->
                <NavigationViewItem x:Name="ScenesNavItem" Content="Scenes" Tag="Scenes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition/>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
