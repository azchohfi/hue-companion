<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HueWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows"
    xmlns:views="using:HueWindows.Views"
    Title="Hue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pane Toggle Button -->
            <Button x:Name="PaneToggleButton"
                    Grid.Column="0"
                    Style="{StaticResource PaneToggleButtonStyle}"
                    Width="40" Height="32"
                    Click="PaneToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="16"/>
            </Button>

            <!-- Back Button -->
            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Width="40" Height="32"
                    IsEnabled="{x:Bind CanGoBack, Mode=OneWay}"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
            </Button>

            <!-- App Icon -->
            <FontIcon Grid.Column="2" Glyph="&#xE781;" FontSize="16" Margin="8,0,8,0"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center"/>

            <!-- Title -->
            <TextBlock Grid.Column="3" Text="Hue"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="240"
            ExpandedModeThresholdWidth="1000"
            CompactModeThresholdWidth="600"
            IsTabStop="False"
            IsTitleBarAutoPaddingEnabled="False">

            <NavigationView.MenuItems>
                <!-- Home -->
                <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Rooms Header -->
                <NavigationViewItemHeader x:Name="RoomsHeader" Content="Rooms"/>

                <!-- Room items will be dynamically inserted here -->

                <!-- Zones Header -->
                <NavigationViewItemHeader x:Name="ZonesHeader" Content="Zones"/>

                <!-- Zone items will be dynamically inserted here -->
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="0"/>
        </NavigationView>
    </Grid>
</Window>
