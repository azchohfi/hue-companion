{
  "id": "christmas_twinkle",
  "name": "Christmas Twinkle",
  "description": "Festive twinkling lights in red and green",
  "category": "Holiday",
  "previewColor": {
    "x": 0.65,
    "y": 0.33
  },
  "paletteColors": [
    { "x": 0.65, "y": 0.33 },
    { "x": 0.28, "y": 0.60 },
    { "x": 0.32, "y": 0.32 }
  ],
  "defaultTargeting": "room",
  "animations": [
    {
      "id": "base_glow",
      "name": "Base Glow",
      "type": "keyframe",
      "lightAssignment": "all",
      "keyframes": [
        {
          "timeSeconds": 0,
          "brightness": 0.4,
          "color": { "x": 0.32, "y": 0.32 },
          "isOn": true,
          "transitionStyle": "linear"
        },
        {
          "timeSeconds": 3,
          "brightness": 0.5,
          "color": { "x": 0.32, "y": 0.32 },
          "isOn": true,
          "transitionStyle": "easeInOut"
        },
        {
          "timeSeconds": 6,
          "brightness": 0.4,
          "color": { "x": 0.32, "y": 0.32 },
          "isOn": true,
          "transitionStyle": "easeInOut"
        }
      ],
      "durationSeconds": 6,
      "repeatMode": "loop",
      "priority": 1
    },
    {
      "id": "sparkles",
      "name": "Sparkles",
      "type": "event",
      "lightAssignment": "random",
      "randomPercentage": 0.4,
      "eventPattern": {
        "triggers": [
          {
            "weight": 1.0,
            "states": [
              {
                "durationSeconds": 0.2,
                "brightness": 0.9,
                "color": { "x": 0.65, "y": 0.33 },
                "isOn": true,
                "transitionStyle": "instant"
              },
              {
                "durationSeconds": 0.4,
                "brightness": 0.4,
                "color": { "x": 0.32, "y": 0.32 },
                "isOn": true,
                "transitionStyle": "easeOut"
              }
            ]
          },
          {
            "weight": 1.0,
            "states": [
              {
                "durationSeconds": 0.2,
                "brightness": 0.85,
                "color": { "x": 0.28, "y": 0.60 },
                "isOn": true,
                "transitionStyle": "instant"
              },
              {
                "durationSeconds": 0.4,
                "brightness": 0.4,
                "color": { "x": 0.32, "y": 0.32 },
                "isOn": true,
                "transitionStyle": "easeOut"
              }
            ]
          }
        ],
        "minIntervalSeconds": 0.3,
        "maxIntervalSeconds": 1.5,
        "probability": 0.9,
        "allowSimultaneous": true,
        "maxSimultaneous": 3
      },
      "durationSeconds": 0,
      "repeatMode": "loop",
      "priority": 2
    }
  ],
  "author": "HueWindows",
  "version": "1.0"
}
