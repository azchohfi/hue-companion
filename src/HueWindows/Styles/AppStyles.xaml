<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         Theme-Aware Card Backgrounds
         ===================================================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Card gradient colors for dark theme -->
            <Color x:Key="CardGradientColor1">#FF1A1A1E</Color>
            <Color x:Key="CardGradientColor2">#FF252528</Color>
            <Color x:Key="CardGradientColor3">#FF1E1E22</Color>
            <Color x:Key="CardHoverGradientColor1">#FF222226</Color>
            <Color x:Key="CardHoverGradientColor2">#FF2D2D30</Color>
            <Color x:Key="CardHoverGradientColor3">#FF262629</Color>
            <!-- Effect card gradient (warmer tint) -->
            <Color x:Key="EffectCardGradientColor1">#FF1E1A1A</Color>
            <Color x:Key="EffectCardGradientColor2">#FF282225</Color>
            <Color x:Key="EffectCardGradientColor3">#FF221E1E</Color>
            <!-- Icon and text brushes -->
            <SolidColorBrush x:Key="CardIconBackgroundBrush" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="CardIconForegroundBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="CardPrimaryTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="CardSecondaryTextBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="CardTertiaryTextBrush" Color="#60FFFFFF"/>
            <SolidColorBrush x:Key="CardTrackBackgroundBrush" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="CardTrackFillBrush" Color="#60FFFFFF"/>
            <Color x:Key="CardInnerHighlightColor">#40FFFFFF</Color>
            <Color x:Key="CardInnerShadowColor">#40000000</Color>
            <Color x:Key="CardCornerGlowColor">#33FFFFFF</Color>
            <Color x:Key="CardCornerShadowColor">#4D000000</Color>
            <Color x:Key="CardEdgeGlowColor">#26FFFFFF</Color>
            <!-- Toggle off track -->
            <SolidColorBrush x:Key="ToggleOffTrackFillBrush" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="ToggleOffTrackBorderBrush" Color="#20FFFFFF"/>
            <!-- Button overlay colors -->
            <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#15FFFFFF"/>
            <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#10000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!-- Card gradient colors for light theme -->
            <Color x:Key="CardGradientColor1">#FFF5F5F5</Color>
            <Color x:Key="CardGradientColor2">#FFFAFAFA</Color>
            <Color x:Key="CardGradientColor3">#FFF8F8F8</Color>
            <Color x:Key="CardHoverGradientColor1">#FFEDEDED</Color>
            <Color x:Key="CardHoverGradientColor2">#FFF0F0F0</Color>
            <Color x:Key="CardHoverGradientColor3">#FFEEEEEE</Color>
            <!-- Effect card gradient (warmer tint) -->
            <Color x:Key="EffectCardGradientColor1">#FFF5F2F2</Color>
            <Color x:Key="EffectCardGradientColor2">#FFFAF7F7</Color>
            <Color x:Key="EffectCardGradientColor3">#FFF8F5F5</Color>
            <!-- Icon and text brushes -->
            <SolidColorBrush x:Key="CardIconBackgroundBrush" Color="#15000000"/>
            <SolidColorBrush x:Key="CardIconForegroundBrush" Color="#80000000"/>
            <SolidColorBrush x:Key="CardPrimaryTextBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="CardSecondaryTextBrush" Color="#80000000"/>
            <SolidColorBrush x:Key="CardTertiaryTextBrush" Color="#60000000"/>
            <SolidColorBrush x:Key="CardTrackBackgroundBrush" Color="#20000000"/>
            <SolidColorBrush x:Key="CardTrackFillBrush" Color="#40000000"/>
            <Color x:Key="CardInnerHighlightColor">#22FFFFFF</Color>
            <Color x:Key="CardInnerShadowColor">#30000000</Color>
            <Color x:Key="CardCornerGlowColor">#26FFFFFF</Color>
            <Color x:Key="CardCornerShadowColor">#33000000</Color>
            <Color x:Key="CardEdgeGlowColor">#1FFFFFFF</Color>
            <!-- Toggle off track -->
            <SolidColorBrush x:Key="ToggleOffTrackFillBrush" Color="#20000000"/>
            <SolidColorBrush x:Key="ToggleOffTrackBorderBrush" Color="#20000000"/>
            <!-- Button overlay colors -->
            <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#10000000"/>
            <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#15000000"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- =====================================================
         ToggleSwitch Premium Styling - Theme Resource Overrides
         ===================================================== -->

    <!-- Track (Off State) - Deeper with transparency -->
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#15FFFFFF"/>

    <!-- Track Border (Off State) - Subtle definition -->
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#50FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#35FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#20FFFFFF"/>

    <!-- Track (On State) - Accent color -->
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentFillColorDefaultBrush"/>
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentFillColorSecondaryBrush"/>
    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentFillColorTertiaryBrush"/>
    <StaticResource x:Key="ToggleSwitchFillOnDisabled" ResourceKey="AccentFillColorDisabledBrush"/>

    <!-- Track Border (On State) - Clean with no border -->
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent"/>

    <!-- Knob (Off State) - Clean white with subtle transparency -->
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#60FFFFFF"/>

    <!-- Knob (On State) - Bright white for contrast -->
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E8FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#80FFFFFF"/>

    <!-- =====================================================
         Text Styles
         ===================================================== -->

    <!-- Page Header Style -->
    <Style x:Key="PageHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>

    <!-- Page Subtitle Style -->
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Section Header Style -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Elevated Card Style (for interactive cards) -->
    <Style x:Key="ElevatedCardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Settings Card Button Style -->
    <Style x:Key="SettingsCardButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Icon Button Style -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Pane Toggle Button Style -->
    <Style x:Key="PaneToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Navigation Back Button Style -->
    <Style x:Key="NavigationBackButtonNormalStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Compact Toggle Switch (no labels, premium look) -->
    <Style x:Key="CompactToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Custom Gradient Toggle Switch (Animated, No Pink, Readable Knob) -->
    <Style x:Key="GradientToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <!-- Default Gradient Background (overridden by local value) -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid x:Name="LayoutRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Dragging"/>
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Track Area -->
                        <Grid x:Name="SwitchKnobBounds" Width="40" Height="20" Background="Transparent">
                            
                            <!-- Off State Track -->
                            <Border x:Name="OffTrack"
                                    Background="{ThemeResource ToggleOffTrackFillBrush}"
                                    BorderBrush="{ThemeResource ToggleOffTrackBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" />

                            <!-- On State Track (Gradient) -->
                            <Border x:Name="OnTrack" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="10" 
                                    Opacity="0"/>
                            
                            <!-- Knob -->
                            <Grid x:Name="SwitchKnob" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>
                                
                                <!-- Shadow/Glow behind knob -->
                                <Ellipse Fill="#40000000" Margin="1,1,-1,-1" Opacity="0.5"/>
                                
                                <!-- Main Knob -->
                                <Ellipse x:Name="KnobEllipse" Fill="White" />
                                
                                <!-- Stronger Border -->
                                <Ellipse Stroke="#30000000" StrokeThickness="1" />
                            </Grid>
                        </Grid>
                        
                        <!-- Required ContentPresenter (Hidden) -->
                        <ContentPresenter x:Name="ContentPresenter" Opacity="0" IsHitTestVisible="False"/>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Standard Toggle Switch (with labels, premium look) -->
    <Style x:Key="PremiumToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="On"/>
        <Setter Property="OffContent" Value="Off"/>
    </Style>

    <!-- Subtle Progress Bar -->
    <Style x:Key="SubtleProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
    </Style>

    <!-- Slider Theme Overrides for larger thumb -->
    <x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">22</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">11</CornerRadius>

    <!-- Scene Button Style -->
    <Style x:Key="SceneButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
    </Style>

    <!-- Scene Card Button Style - Preserves background color, uses opacity for hover -->
    <Style x:Key="SceneCardButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Hover overlay - theme-aware -->
                        <Border x:Name="HoverOverlay" Background="{ThemeResource ButtonHoverOverlayBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>

                        <!-- Pressed overlay - theme-aware -->
                        <Border x:Name="PressedOverlay" Background="{ThemeResource ButtonPressedOverlayBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Effect Card Button Style - Theme-aware for native effects -->
    <Style x:Key="EffectCardButtonStyle" TargetType="Button" BasedOn="{StaticResource SceneCardButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
    </Style>

    <!-- Active Scene Button Style -->
    <Style x:Key="ActiveSceneButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,16"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Light Card Style -->
    <Style x:Key="LightCardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Empty State Style -->
    <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- Secondary Text Style -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- Spacing Constants -->
    <x:Double x:Key="PagePadding">24</x:Double>
    <x:Double x:Key="SectionSpacing">24</x:Double>
    <x:Double x:Key="ItemSpacing">12</x:Double>
    <x:Double x:Key="CompactItemSpacing">8</x:Double>
    <Thickness x:Key="PageMargin">24,0,24,24</Thickness>
    <Thickness x:Key="HeaderMargin">24,24,24,16</Thickness>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>

    <!-- Color Picker Flyout Presenter Style -->
    <Style x:Key="ColorPickerFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Color SplitButton Style -->
    <Style x:Key="ColorSplitButtonStyle" TargetType="SplitButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="56"/>
    </Style>

</ResourceDictionary>
