<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.SceneLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:models="using:HueWindows.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Scene Library"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Browse animated lighting scenes"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.LoadDataCommand}"
                    Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading scenes..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36" Spacing="32">

                <!-- Error Message -->
                <InfoBar IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True"/>

                <!-- Room Selection -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Target Room"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="200"
                              PlaceholderText="Select a room"/>
                </StackPanel>

                <!-- Animation Status -->
                <StackPanel Visibility="{x:Bind ViewModel.IsAnimationPlaying, Mode=OneWay}"
                            Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Now Playing"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentAnimationName, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Stop"
                                Command="{x:Bind ViewModel.StopSceneCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Category"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ToggleButton Content="{x:Bind}"
                                              Click="CategoryButton_Click"
                                              Tag="{x:Bind}"
                                              MinWidth="100"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Scenes Grid -->
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind GetSceneCountText(ViewModel.FilteredScenes.Count), Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredScenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="250"
                                               MinItemHeight="140"
                                               MinRowSpacing="16"
                                               MinColumnSpacing="16"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AnimatedSceneModel">
                                <Button Click="Scene_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4">
                                                <TextBlock Text="{x:Bind Category}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind AnimationCountText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel Visibility="{x:Bind ShowEmptyState(ViewModel.FilteredScenes.Count), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            Margin="0,32,0,0">
                    <FontIcon Glyph="&#xE8F1;"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No scenes found"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try selecting a different category"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
