<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.RoomDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:converters="using:HueWindows.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:HexToSolidColorBrushConverter x:Key="HexToBrushConverter"/>
        <converters:HexToVisibilityConverter x:Key="HexToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Room Controls -->
        <Grid x:Name="HeaderContainer" Grid.Row="0" Margin="36,32,36,24"
              CornerRadius="16">
            <!-- Dark gradient background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1E" Offset="0"/>
                    <GradientStop Color="#FF252528" Offset="0.5"/>
                    <GradientStop Color="#FF1E1E22" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Outline borders for room colors - two for cross-fade -->
            <Border x:Name="HeaderOutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="HeaderOutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <Grid Canvas.ZIndex="1" Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Room icon -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                        Background="#20FFFFFF" Margin="0,0,16,0">
                    <FontIcon x:Name="RoomIcon"
                              Glyph="&#xE781;"
                              FontSize="22"
                              Foreground="#80FFFFFF"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.RoomName, Mode=OneWay}"
                               Style="{StaticResource PageHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}">
                        <Run Text="{x:Bind ViewModel.Lights.Count, Mode=OneWay}"/>
                        <Run Text=" lights"/>
                    </TextBlock>
                </StackPanel>

                <ToggleSwitch x:Name="RoomToggle"
                              Grid.Column="2"
                              Style="{StaticResource GradientToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                              Tapped="RoomToggle_Tapped"/>
            </Grid>
        </Grid>

        <!-- Room Brightness Card -->
        <Grid x:Name="BrightnessContainer" Grid.Row="1" Margin="36,0,36,24"
              CornerRadius="8">
            <!-- Dark gradient background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1E" Offset="0"/>
                    <GradientStop Color="#FF252528" Offset="0.5"/>
                    <GradientStop Color="#FF1E1E22" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Outline borders for room colors - two for cross-fade -->
            <Border x:Name="BrightnessOutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="BrightnessOutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <Grid Canvas.ZIndex="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="BrightnessIcon" Grid.Column="0" Glyph="&#xE706;" FontSize="20" Margin="0,0,16,0"
                          Foreground="#80FFFFFF"/>

                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"
                        ValueChanged="BrightnessSlider_ValueChanged"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           MinWidth="40"
                           TextAlignment="Right"
                           Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                    <Run Text="%"/>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="36,0,36,36" Spacing="28">

                <!-- Scenes Section -->
                <StackPanel Visibility="{x:Bind HasScenes(ViewModel.Scenes.Count), Mode=OneWay}">
                    <TextBlock Text="Scenes"
                               Style="{StaticResource SectionHeaderTextStyle}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="110"
                                               MinItemHeight="72"
                                               MinRowSpacing="8"
                                               MinColumnSpacing="8"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneItemViewModel">
                                <Grid>
                                    <Button HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="8,10"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Command="{x:Bind ActivateCommand}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <FontIcon Glyph="&#xE91B;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="90"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <!-- Color swatches -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="3"
                                                        Visibility="{x:Bind HasPaletteColors}">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{x:Bind Color1Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color1Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{x:Bind Color2Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color2Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{x:Bind Color3Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color3Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{x:Bind Color4Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color4Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <!-- Active indicator border -->
                                    <Border BorderThickness="2"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Lights Section -->
                <StackPanel>
                    <TextBlock Text="Lights"
                               Style="{StaticResource SectionHeaderTextStyle}"/>

                    <ItemsRepeater x:Name="LightsRepeater" ItemsSource="{x:Bind ViewModel.Lights, Mode=OneWay}"
                                    ElementPrepared="LightsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LightItemViewModel">
                                <controls:LightCard/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Error Message -->
        <InfoBar Grid.Row="2"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
