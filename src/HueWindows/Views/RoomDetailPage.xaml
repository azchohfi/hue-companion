<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.RoomDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Room Controls -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.RoomName, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"/>

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                    <Run Text="{x:Bind ViewModel.Lights.Count, Mode=OneWay}"/>
                    <Run Text=" lights"/>
                </TextBlock>
            </StackPanel>

            <ToggleSwitch Grid.Column="1"
                          IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                          OnContent="On"
                          OffContent="Off"/>
        </Grid>

        <!-- Room Brightness Slider -->
        <Grid Grid.Row="1" Padding="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Slider Grid.Column="0"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"
                    ValueChanged="BrightnessSlider_ValueChanged"
                    Header="Brightness"/>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="12,0,0,8"
                       Style="{StaticResource BodyStrongTextBlockStyle}">
                <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                <Run Text="%"/>
            </TextBlock>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="24,0,24,24" Spacing="24">

                <!-- Scenes Section -->
                <StackPanel Visibility="{x:Bind HasScenes(ViewModel.Scenes.Count), Mode=OneWay}">
                    <TextBlock Text="Scenes"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120"
                                               MinItemHeight="80"
                                               MinRowSpacing="8"
                                               MinColumnSpacing="8"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneItemViewModel">
                                <Grid>
                                    <Button HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Command="{x:Bind ActivateCommand}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <FontIcon Glyph="&#xE91B;" FontSize="20"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="100"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Active indicator border -->
                                    <Border BorderThickness="2"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Lights Section -->
                <StackPanel>
                    <TextBlock Text="Lights"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lights, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LightItemViewModel">
                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      CornerRadius="8"
                                      Padding="16"
                                      PointerPressed="LightCard_PointerPressed"
                                      Tag="{x:Bind LightId}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE781;"
                                              FontSize="24"
                                              Margin="0,0,16,0"
                                              Opacity="{x:Bind IconOpacity, Mode=OneWay}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                                            <Run Text="{x:Bind BrightnessPercent, Mode=OneWay}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>
    </Grid>
</Page>
