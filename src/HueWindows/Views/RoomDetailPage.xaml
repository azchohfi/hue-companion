<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.RoomDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Room Controls -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Bind ViewModel.RoomName, Mode=OneWay}"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}">
                    <Run Text="{x:Bind ViewModel.Lights.Count, Mode=OneWay}"/>
                    <Run Text=" lights"/>
                </TextBlock>
            </StackPanel>

            <ToggleSwitch Grid.Column="1"
                          VerticalAlignment="Top"
                          IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                          OnContent="On"
                          OffContent="Off"/>
        </Grid>

        <!-- Room Brightness Card -->
        <Grid Grid.Row="1" Margin="36,0,36,24"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="20" Margin="0,0,16,0"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"
                    ValueChanged="BrightnessSlider_ValueChanged"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       MinWidth="40"
                       TextAlignment="Right"
                       Style="{StaticResource BodyStrongTextBlockStyle}">
                <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                <Run Text="%"/>
            </TextBlock>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="36,0,36,36" Spacing="28">

                <!-- Scenes Section -->
                <StackPanel Visibility="{x:Bind HasScenes(ViewModel.Scenes.Count), Mode=OneWay}">
                    <TextBlock Text="Scenes"
                               Style="{StaticResource SectionHeaderTextStyle}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="110"
                                               MinItemHeight="72"
                                               MinRowSpacing="8"
                                               MinColumnSpacing="8"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneItemViewModel">
                                <Grid>
                                    <Button HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="8,12"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Command="{x:Bind ActivateCommand}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <FontIcon Glyph="&#xE91B;" FontSize="18"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="90"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Active indicator border -->
                                    <Border BorderThickness="2"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Lights Section -->
                <StackPanel>
                    <TextBlock Text="Lights"
                               Style="{StaticResource SectionHeaderTextStyle}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lights, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LightItemViewModel">
                                <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="16,12"
                                      PointerPressed="LightCard_PointerPressed"
                                      Tag="{x:Bind LightId}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            Margin="0,0,14,0">
                                        <FontIcon Glyph="&#xE781;"
                                                  FontSize="16"
                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind BrightnessPercent, Mode=OneWay}"/>
                                            <Run Text="% brightness"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>
    </Grid>
</Page>
