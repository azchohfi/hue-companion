<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.RoomDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:models="using:HueWindows.Core.Models"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:converters="using:HueWindows.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:HexToSolidColorBrushConverter x:Key="HexToBrushConverter"/>
        <converters:HexToVisibilityConverter x:Key="HexToVisibilityConverter"/>
        <converters:HexToGradientBackgroundConverter x:Key="HexToGradientBackgroundConverter"/>
        <converters:HexToGradientBorderConverter x:Key="HexToGradientBorderConverter"/>
        <converters:BoolToOpacityActiveConverter x:Key="BoolToOpacityActiveConverter"/>

        <Style x:Key="EffectFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Room Controls and Brightness -->
        <Grid x:Name="HeaderContainer" Grid.Row="0" Margin="36,32,36,24"
              CornerRadius="16">
            <!-- Background set in code-behind for theme-aware gradients -->

            <!-- Outline borders for room colors - two for cross-fade -->
            <Border x:Name="OutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="OutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <StackPanel Canvas.ZIndex="1" Margin="24,20" Spacing="20">
                <!-- Header: Icon, Name, Color Button, Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Room icon (tap to change) -->
                    <Border x:Name="HeaderIconContainer" Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,16,0"
                            Tapped="HeaderIcon_Tapped">
                        <FontIcon x:Name="RoomIcon"
                                  Glyph="{x:Bind ViewModel.RoomIconGlyph, Mode=OneWay}"
                                  FontSize="22"
                                  Foreground="Transparent"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.RoomName, Mode=OneWay}"
                                   Style="{StaticResource PageHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}">
                            <Run Text="{x:Bind ViewModel.Lights.Count, Mode=OneWay}"/>
                            <Run Text=" lights"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Color SplitButton -->
                    <SplitButton x:Name="ColorSplitButton"
                                 Grid.Column="2"
                                 Style="{StaticResource ColorSplitButtonStyle}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Visibility="{x:Bind ViewModel.SupportsColor, Mode=OneWay}">
                        <Border x:Name="ColorButtonContent" CornerRadius="6"
                                Background="Transparent"
                                Margin="-12,-8"
                                Padding="16,12">
                            <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="White"/>
                        </Border>
                        <SplitButton.Flyout>
                            <Flyout x:Name="ColorPickerFlyout"
                                    Placement="Bottom"
                                    ShouldConstrainToRootBounds="False"
                                    Opening="ColorPickerFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <controls:ColorPickerFlyout x:Name="ColorFlyout" ColorChanged="ColorFlyout_ColorChanged"/>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Save as Scene"
                            Click="SaveAsScene_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                    </Button>

                    <!-- More menu -->
                    <Button Grid.Column="4"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="More options"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <FontIcon Glyph="&#xE712;" FontSize="16"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Rename" Click="RenameRoom_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Change Type" Click="ChangeRoomType_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEBC6;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Delete" Click="DeleteRoom_Click" Foreground="#FF4444">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#FF4444"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <ToggleSwitch x:Name="RoomToggle"
                                  Grid.Column="5"
                                  Style="{StaticResource GradientToggleSwitchStyle}"
                                  VerticalAlignment="Center"
                                  IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                                  Tapped="RoomToggle_Tapped"/>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}"/>

                <!-- Brightness Section -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="BrightnessIcon" Glyph="&#xE706;" FontSize="18"
                                  Foreground="Transparent"/>
                        <TextBlock Text="Brightness" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="BrightnessSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                ValueChanged="BrightnessSlider_ValueChanged"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   MinWidth="40"
                                   TextAlignment="Right"
                                   Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <!-- Note: Using nested ScrollViewers to isolate ItemsRepeater layout calculations and prevent layout cycles -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="36,0,36,36" Spacing="28">

                <!-- Lights Section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Lights" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Expander.Header>
                    <GridView x:Name="LightsGrid"
                              ItemsSource="{x:Bind ViewModel.Lights, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              CanReorderItems="True"
                              AllowDrop="True"
                              DragItemsCompleted="LightsGrid_DragItemsCompleted"
                              ContainerContentChanging="LightsGrid_ContainerContentChanging"
                              SizeChanged="LightsGrid_SizeChanged"
                              Margin="-6,0,-6,0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6,4,6,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LightItemViewModel">
                                <controls:LightCard/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Expander>

                <!-- Scenes Section (unified: native + animated) -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind HasScenes(ViewModel.UnifiedScenes.Count), Mode=OneWay}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scenes"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>
                            <Button Grid.Column="1"
                                    Click="AddScene_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Add scene from library"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                    <!-- Now Playing Card -->
                    <Border Visibility="{x:Bind ViewModel.IsAnimationRunning, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                       Glyph="&#xE768;"
                                       FontSize="20"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Now Playing"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.RunningAnimationName, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="Stop"
                                    Command="{x:Bind ViewModel.StopAnimationCommand}"/>
                        </Grid>
                    </Border>

                    <GridView x:Name="ScenesGrid"
                              ItemsSource="{x:Bind ViewModel.UnifiedScenes, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              SizeChanged="ScenesGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnifiedSceneItemViewModel">
                                <Grid HorizontalAlignment="Stretch"
                                      RenderTransformOrigin="0.5,0.5"
                                      Loaded="SceneContainer_Loaded"
                                      Unloaded="SceneContainer_Unloaded">
                                    <Grid.RenderTransform>
                                        <ScaleTransform/>
                                    </Grid.RenderTransform>
                                    <Button Style="{StaticResource SceneCardButtonStyle}"
                                            Background="{x:Bind Color1Hex, Converter={StaticResource HexToGradientBackgroundConverter}}"
                                            Command="{x:Bind ActivateCommand}">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Add to Quick Access"
                                                                Click="FavoriteScene_Click"
                                                                Tag="{x:Bind}"
                                                                Visibility="{x:Bind IsNative}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE734;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Delete"
                                                                Click="DeleteScene_Click"
                                                                Tag="{x:Bind}"
                                                                Visibility="{x:Bind IsNative}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Remove from room"
                                                                Click="RemoveScene_Click"
                                                                Tag="{x:Bind}"
                                                                Visibility="{x:Bind IsAnimated}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE77A;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16"
                                                      Foreground="{x:Bind Color1Hex, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="90"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="4"
                                                        Visibility="{x:Bind HasPaletteColors}">
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{x:Bind Color1Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color1Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{x:Bind Color2Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color2Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{x:Bind Color3Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color3Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{x:Bind Color4Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Visibility="{x:Bind Color4Hex, Converter={StaticResource HexToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Border BorderThickness="3"
                                            BorderBrush="{x:Bind Color1Hex, Converter={StaticResource HexToGradientBorderConverter}}"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToOpacityActiveConverter}}"/>
                                    <!-- Active checkmark badge -->
                                    <Border CornerRadius="10" Width="20" Height="20"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="4"
                                            Background="{x:Bind Color1Hex, Converter={StaticResource HexToBrushConverter}}"
                                            Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToOpacityActiveConverter}}"
                                            IsHitTestVisible="False">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    </StackPanel>
                </Expander>

                <!-- Hue Effects Section -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Hue Effects" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Expander.Header>
                    <GridView x:Name="NativeEffectsGrid"
                              ItemsSource="{x:Bind ViewModel.NativeEffects}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              SizeChanged="NativeEffectsGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:NativeEffectInfo">
                                <Grid HorizontalAlignment="Stretch">
                                    <Button Style="{StaticResource EffectCardButtonStyle}"
                                            Background="{x:Bind AccentColorHex, Converter={StaticResource HexToGradientBackgroundConverter}}"
                                            Click="NativeEffect_Click"
                                            Tag="{x:Bind}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16"
                                                      Foreground="{x:Bind AccentColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="90"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Error Message -->
        <InfoBar Grid.Row="1"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
