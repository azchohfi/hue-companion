<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Home"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Control your Hue lights"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Room and Zone Cards -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36" Spacing="24">

                <!-- Rooms Section -->
                <StackPanel Visibility="{x:Bind ViewModel.HasRooms, Mode=OneWay}">
                    <TextBlock Text="Rooms"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>
                    <ItemsRepeater x:Name="RoomCardsRepeater"
                                   ItemsSource="{x:Bind ViewModel.RoomCards, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300"
                                               MinItemHeight="130"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomCardViewModel">
                                <controls:RoomCard DataContext="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Zones Section -->
                <StackPanel Visibility="{x:Bind ViewModel.HasZones, Mode=OneWay}">
                    <TextBlock Text="Zones"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,12"/>
                    <ItemsRepeater x:Name="ZoneCardsRepeater"
                                   ItemsSource="{x:Bind ViewModel.ZoneCards, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300"
                                               MinItemHeight="130"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomCardViewModel">
                                <controls:RoomCard DataContext="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="320">

            <FontIcon Glyph="&#xE8B9;"
                      Style="{StaticResource EmptyStateIconStyle}"/>

            <TextBlock Text="No rooms or zones found"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Add rooms in the Philips Hue app first, then refresh here"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <Button Content="Refresh"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.RefreshCommand}"/>
        </StackPanel>

        <!-- Error Message -->
        <InfoBar Grid.Row="1"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
