<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Rooms"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Room Cards Grid -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <ItemsRepeater x:Name="RoomCardsRepeater"
                           ItemsSource="{x:Bind ViewModel.RoomCards, Mode=OneWay}"
                           Margin="24,0,24,24">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="280"
                                       MinItemHeight="140"
                                       MinRowSpacing="16"
                                       MinColumnSpacing="16"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomCardViewModel">
                        <controls:RoomCard DataContext="{x:Bind}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">

            <FontIcon Glyph="&#xE8B9;"
                      FontSize="64"
                      Opacity="0.5"/>

            <TextBlock Text="No rooms found"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Add rooms in the Philips Hue app first, then refresh"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       HorizontalAlignment="Center"/>

            <Button Content="Refresh"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"/>
        </StackPanel>

        <!-- Error Message -->
        <InfoBar Grid.Row="1"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="24"/>
    </Grid>
</Page>
