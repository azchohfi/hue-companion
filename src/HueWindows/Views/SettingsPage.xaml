<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:models="using:HueWindows.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24" MaxWidth="800">

            <!-- Header -->
            <TextBlock Text="Settings"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Theme Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="App theme"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Select which app theme to display"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              SelectedIndex="{x:Bind GetThemeIndex(ViewModel.SelectedTheme), Mode=OneWay}"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              MinWidth="150">
                        <ComboBoxItem Content="Use system setting"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Bridge Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Hue Bridge"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE968;"
                                  FontSize="32"
                                  Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Hue Bridge"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8"
                                         Fill="{x:Bind GetConnectionColor(ViewModel.IsConnected), Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind GetConnectionStatus(ViewModel.IsConnected), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                            <Run Text="IP Address: "/>
                            <Run Text="{x:Bind ViewModel.BridgeIpAddress, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                            <Run Text="Bridge ID: "/>
                            <Run Text="{x:Bind ViewModel.BridgeId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Reconnect"
                                Command="{x:Bind ViewModel.RepairBridgeCommand}"/>
                        <Button Content="Disconnect"
                                Command="{x:Bind ViewModel.DisconnectBridgeCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="About"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Hue Windows"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                            <Run Text="Version "/>
                            <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="Control your Philips Hue lights from Windows. This app is not affiliated with Signify (Philips Hue)."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               TextWrapping="WrapWholeWords"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
