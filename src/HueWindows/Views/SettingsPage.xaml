<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:models="using:HueWindows.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="36,32,36,36" Spacing="28" MaxWidth="1000" HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Settings"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Customize your experience"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <!-- Theme Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Select which app theme to display"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              SelectedIndex="{x:Bind GetThemeIndex(ViewModel.SelectedTheme), Mode=OneWay}"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              MinWidth="160"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Use system setting"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Bridge Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Hue Bridge"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE968;" FontSize="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Hue Bridge"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border CornerRadius="4"
                                    Padding="6,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{x:Bind GetConnectionColor(ViewModel.IsConnected), Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind GetConnectionStatus(ViewModel.IsConnected), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind ViewModel.BridgeIpAddress, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Reconnect"
                                Command="{x:Bind ViewModel.RepairBridgeCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="About"
                           Style="{StaticResource SectionHeaderTextStyle}"/>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE781;" FontSize="24"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Hue Windows"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Version "/>
                            <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="A modern Philips Hue controller for Windows"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
