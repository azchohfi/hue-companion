<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.LightDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Bind ViewModel.LightName, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <ToggleSwitch Grid.Column="1"
                          IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                          OnContent="On"
                          OffContent="Off"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="24">

                <!-- Brightness Control -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0"
                            x:Name="BrightnessSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"
                            ValueChanged="BrightnessSlider_ValueChanged"
                            Header="Brightness"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Bottom"
                               Margin="12,0,0,8"
                               Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </Grid>

                <!-- Color/Temperature Mode Selector -->
                <Grid Visibility="{x:Bind BothColorModesSupported(), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0"
                                 Content="Color"
                                 GroupName="ColorMode"
                                 IsChecked="{x:Bind ViewModel.IsColorMode, Mode=TwoWay}"
                                 Command="{x:Bind ViewModel.SwitchToColorModeCommand}"/>

                    <RadioButton Grid.Column="1"
                                 Content="Temperature"
                                 GroupName="ColorMode"
                                 IsChecked="{x:Bind InvertBool(ViewModel.IsColorMode), Mode=OneWay}"
                                 Command="{x:Bind ViewModel.SwitchToTemperatureModeCommand}"/>
                </Grid>

                <!-- Color Picker -->
                <StackPanel Visibility="{x:Bind ShowColorPicker(), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Color" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <ColorPicker x:Name="LightColorPicker"
                                 ColorSpectrumShape="Ring"
                                 IsMoreButtonVisible="False"
                                 IsColorSliderVisible="True"
                                 IsColorChannelTextInputVisible="False"
                                 IsHexInputVisible="True"
                                 IsAlphaEnabled="False"
                                 ColorChanged="ColorPicker_ColorChanged"/>
                </StackPanel>

                <!-- Color Temperature Slider -->
                <StackPanel Visibility="{x:Bind ShowTemperaturePicker(), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Color Temperature" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Slider Grid.Row="0"
                                x:Name="TemperatureSlider"
                                Minimum="{x:Bind ViewModel.MinColorTemp}"
                                Maximum="{x:Bind ViewModel.MaxColorTemp}"
                                Value="{x:Bind ViewModel.ColorTemperature, Mode=OneWay}"
                                ValueChanged="TemperatureSlider_ValueChanged"
                                IsDirectionReversed="True"/>

                        <!-- Temperature Gradient Bar -->
                        <Border Grid.Row="1" Height="24" CornerRadius="4" Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFCC99" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#CCE5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Warm" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock Text="Cool" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>
    </Grid>
</Page>
