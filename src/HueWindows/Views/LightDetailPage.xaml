<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.LightDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <!-- Single unified card containing all controls -->
        <ScrollViewer>
            <Grid x:Name="MainContainer" Margin="36,32,36,36" CornerRadius="16">
                <!-- Background set in code-behind for theme-aware gradients -->

                <!-- Outline borders for light color - two for cross-fade -->
                <Border x:Name="OutlineBorder"
                        Canvas.ZIndex="0"
                        CornerRadius="16"
                        BorderThickness="2"
                        IsHitTestVisible="False"
                        Opacity="0"/>
                <Border x:Name="OutlineBorder2"
                        Canvas.ZIndex="0"
                        CornerRadius="16"
                        BorderThickness="2"
                        IsHitTestVisible="False"
                        Opacity="0"/>

                <!-- All controls in a single StackPanel -->
                <StackPanel Canvas.ZIndex="1" Margin="24,20" Spacing="24">

                    <!-- Header: Icon, Name, More, Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Light icon -->
                        <Border x:Name="HeaderIconContainer" Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,16,0">
                            <FontIcon x:Name="LightIcon"
                                      Glyph="&#xE781;"
                                      FontSize="22"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.LightName, Mode=OneWay}"
                                       Style="{StaticResource PageHeaderTextStyle}"/>
                        </StackPanel>

                        <!-- More menu -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="More options"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <FontIcon Glyph="&#xE712;" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename" Click="RenameLight_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AC;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Identify" Click="IdentifyLight_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE781;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <ToggleSwitch x:Name="LightToggle"
                                      Grid.Column="3"
                                      Style="{StaticResource GradientToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                                      Tapped="LightToggle_Tapped"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}"/>

                    <!-- Brightness Section -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="BrightnessIcon" Glyph="&#xE706;" FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                            <TextBlock Text="Brightness" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="BrightnessSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    ValueChanged="BrightnessSlider_ValueChanged"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       MinWidth="40"
                                       TextAlignment="Right"
                                       Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Color Section - visible when light supports color -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.SupportsColor, Mode=OneWay}">
                        <!-- Divider -->
                        <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="ColorIcon" Glyph="&#xE790;" FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                            <TextBlock Text="Color" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ColorPicker x:Name="LightColorPicker"
                                     ColorSpectrumShape="Ring"
                                     IsMoreButtonVisible="False"
                                     IsColorSliderVisible="True"
                                     IsColorChannelTextInputVisible="False"
                                     IsHexInputVisible="True"
                                     IsAlphaEnabled="False"
                                     ColorChanged="ColorPicker_ColorChanged"/>
                    </StackPanel>

                    <!-- Temperature Section - visible when light supports color temperature -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.SupportsColorTemperature, Mode=OneWay}">
                        <!-- Divider -->
                        <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="TemperatureIcon" Glyph="&#xE9CA;" FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                            <TextBlock Text="Color Temperature" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Slider Grid.Row="0"
                                    x:Name="TemperatureSlider"
                                    Minimum="{x:Bind ViewModel.MinColorTemp}"
                                    Maximum="{x:Bind ViewModel.MaxColorTemp}"
                                    Value="{x:Bind ViewModel.ColorTemperature, Mode=OneWay}"
                                    ValueChanged="TemperatureSlider_ValueChanged"
                                    IsDirectionReversed="True"/>

                            <!-- Temperature Gradient Bar -->
                            <Border Grid.Row="1" Height="24" CornerRadius="4" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFCC99" Offset="0"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#CCE5FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Warm" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            <TextBlock Text="Cool" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        </Grid>
                    </StackPanel>

                    <!-- Power-on Behavior Section -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.HasPowerOnConfig, Mode=OneWay}">
                        <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="PowerOnIcon" Glyph="&#xE945;" FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                            <TextBlock Text="Power-on Behavior" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="What this light does when power is restored"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>

                        <RadioButtons x:Name="PowerOnPresetRadio"
                                      SelectionChanged="PowerOnPreset_SelectionChanged">
                            <RadioButton Content="Last state" Tag="LastOnState"/>
                            <RadioButton Content="Full brightness" Tag="Safety"/>
                            <RadioButton Content="Stay off" Tag="PowerFail"/>
                            <RadioButton Content="Custom" Tag="Custom"/>
                        </RadioButtons>

                        <!-- Custom options (visible when Custom is selected) -->
                        <StackPanel x:Name="CustomPowerOnPanel" Spacing="12"
                                    Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Slider x:Name="PowerOnBrightnessSlider"
                                        Grid.Column="0"
                                        Minimum="1"
                                        Maximum="100"
                                        ValueChanged="PowerOnBrightness_ValueChanged"
                                        VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"
                                           MinWidth="40"
                                           TextAlignment="Right"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind FormatPercent(ViewModel.PowerOnBrightness), Mode=OneWay}"/>
                            </Grid>

                            <Button Content="Use current light color"
                                    Click="UseCurrentColorForPowerOn_Click"
                                    Visibility="{x:Bind ViewModel.SupportsColor, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- About Section -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind HasDeviceInfo(ViewModel.ProductName), Mode=OneWay}">
                        <Border Height="1" Background="{ThemeResource CardIconBackgroundBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="18"
                                      Foreground="{ThemeResource CardIconForegroundBrush}"/>
                            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid RowSpacing="4" ColumnSpacing="12" Padding="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Product"
                                       Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{x:Bind ViewModel.ProductName, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model"
                                       Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{x:Bind ViewModel.ModelId, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Firmware"
                                       Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Error Message -->
        <InfoBar Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
