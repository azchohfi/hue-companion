<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.LightDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Light Controls -->
        <Grid x:Name="HeaderContainer" Grid.Row="0" Margin="36,32,36,24"
              CornerRadius="16">
            <!-- Dark gradient background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1E" Offset="0"/>
                    <GradientStop Color="#FF252528" Offset="0.5"/>
                    <GradientStop Color="#FF1E1E22" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Outline borders for light color - two for cross-fade -->
            <Border x:Name="HeaderOutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="HeaderOutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="16"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <Grid Canvas.ZIndex="1" Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Light icon -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                        Background="#20FFFFFF" Margin="0,0,16,0">
                    <FontIcon x:Name="LightIcon"
                              Glyph="&#xE781;"
                              FontSize="22"
                              Foreground="#80FFFFFF"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.LightName, Mode=OneWay}"
                               Style="{StaticResource PageHeaderTextStyle}"/>
                </StackPanel>

                <ToggleSwitch x:Name="LightToggle"
                              Grid.Column="2"
                              Style="{StaticResource GradientToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                              Tapped="LightToggle_Tapped"/>
            </Grid>
        </Grid>

        <!-- Brightness Card -->
        <Grid x:Name="BrightnessContainer" Grid.Row="1" Margin="36,0,36,24"
              CornerRadius="8">
            <!-- Dark gradient background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1E" Offset="0"/>
                    <GradientStop Color="#FF252528" Offset="0.5"/>
                    <GradientStop Color="#FF1E1E22" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Outline borders for light color - two for cross-fade -->
            <Border x:Name="BrightnessOutlineBorder"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>
            <Border x:Name="BrightnessOutlineBorder2"
                    Canvas.ZIndex="0"
                    CornerRadius="8"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <Grid Canvas.ZIndex="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="BrightnessIcon" Grid.Column="0" Glyph="&#xE706;" FontSize="20" Margin="0,0,16,0"
                          Foreground="#80FFFFFF"/>

                <Slider x:Name="BrightnessSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        ValueChanged="BrightnessSlider_ValueChanged"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           MinWidth="40"
                           TextAlignment="Right"
                           Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}"/>
                    <Run Text="%"/>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="36,0,36,36" Spacing="24">

                <!-- Color/Temperature Mode Selector -->
                <Grid Visibility="{x:Bind BothColorModesSupported(), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0"
                                 Content="Color"
                                 GroupName="ColorMode"
                                 IsChecked="{x:Bind ViewModel.IsColorMode, Mode=TwoWay}"
                                 Command="{x:Bind ViewModel.SwitchToColorModeCommand}"/>

                    <RadioButton Grid.Column="1"
                                 Content="Temperature"
                                 GroupName="ColorMode"
                                 IsChecked="{x:Bind InvertBool(ViewModel.IsColorMode), Mode=OneWay}"
                                 Command="{x:Bind ViewModel.SwitchToTemperatureModeCommand}"/>
                </Grid>

                <!-- Color Picker -->
                <StackPanel Visibility="{x:Bind ShowColorPicker(), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Color" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <ColorPicker x:Name="LightColorPicker"
                                 ColorSpectrumShape="Ring"
                                 IsMoreButtonVisible="False"
                                 IsColorSliderVisible="True"
                                 IsColorChannelTextInputVisible="False"
                                 IsHexInputVisible="True"
                                 IsAlphaEnabled="False"
                                 ColorChanged="ColorPicker_ColorChanged"/>
                </StackPanel>

                <!-- Color Temperature Slider -->
                <StackPanel Visibility="{x:Bind ShowTemperaturePicker(), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Color Temperature" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Slider Grid.Row="0"
                                x:Name="TemperatureSlider"
                                Minimum="{x:Bind ViewModel.MinColorTemp}"
                                Maximum="{x:Bind ViewModel.MaxColorTemp}"
                                Value="{x:Bind ViewModel.ColorTemperature, Mode=OneWay}"
                                ValueChanged="TemperatureSlider_ValueChanged"
                                IsDirectionReversed="True"/>

                        <!-- Temperature Gradient Bar -->
                        <Border Grid.Row="1" Height="24" CornerRadius="4" Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFCC99" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#CCE5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Warm" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock Text="Cool" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Error Message -->
        <InfoBar Grid.Row="2"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
