<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.MyDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="My Dashboard"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Your pinned rooms, zones, and lights"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Pinned Items Grid -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36" Spacing="24">

                <!-- Pinned Cards -->
                <ListView x:Name="PinnedItemsListView"
                          ItemsSource="{x:Bind ViewModel.PinnedCards, Mode=OneWay}"
                          CanReorderItems="True"
                          AllowDrop="True"
                          ReorderMode="Enabled"
                          SelectionMode="None"
                          DragItemsCompleted="PinnedItemsListView_DragItemsCompleted"
                          Visibility="{x:Bind InvertBool(ViewModel.ShowEmptyState), Mode=OneWay}"
                          Margin="-6,0,-6,0">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="220"
                                           ItemHeight="128"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="6,4,6,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardCardViewModel">
                            <controls:RoomCard DataContext="{x:Bind}">
                                <controls:RoomCard.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Remove from Dashboard"
                                                        Command="{x:Bind UnpinCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77A;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </controls:RoomCard.ContextFlyout>
                            </controls:RoomCard>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="360">

            <FontIcon Glyph="&#xE728;"
                      Style="{StaticResource EmptyStateIconStyle}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="No pinned items"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Right-click on rooms, zones, or lights to add them to your dashboard for quick access."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Button Content="Go to Dashboard"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="GoToDashboard_Click"/>
        </StackPanel>

        <!-- Error Message -->
        <InfoBar Grid.Row="1"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind HasErrorMessage(ViewModel.ErrorMessage), Mode=OneWay}"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="36,0,36,24"/>
    </Grid>
</Page>
