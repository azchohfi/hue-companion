<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:models="using:HueWindows.Core.Models"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="EffectFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Scenes"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Text="Static and animated lighting scenes"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="CreateScene_Click"
                        ToolTipService.ToolTip="Create new animated scene"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Create Scene"/>
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Refresh"
                        Command="{x:Bind ViewModel.LoadDataCommand}"
                        Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading scenes..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,60" Spacing="32">

                <!-- Error Message -->
                <InfoBar IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True"/>

                <!-- Room Context Banner -->
                <InfoBar Visibility="{x:Bind ViewModel.HasRoomContext, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.HasRoomContext, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Informational"
                         Title="{x:Bind FormatRoomContextTitle(ViewModel.ContextRoomName), Mode=OneWay}"
                         Message="Right-click a scene and choose 'Add to Room' to assign it."/>

                <!-- Room Selection (hidden when room context is set) -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind InvertBool(ViewModel.HasRoomContext), Mode=OneWay}">
                    <TextBlock Text="Target Room"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="200"
                              PlaceholderText="Select a room"/>
                </StackPanel>

                <!-- Animation Status -->
                <StackPanel Visibility="{x:Bind ViewModel.IsAnimationPlaying, Mode=OneWay}"
                            Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Now Playing"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentAnimationName, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Stop"
                                Command="{x:Bind ViewModel.StopAnimatedSceneCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- My Scenes Section (User-Created) -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasUserScenes, Mode=OneWay}">
                    <TextBlock Text="My Scenes"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UserScenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinItemHeight="100"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AnimatedSceneModel">
                                <Grid>
                                    <Button Click="AnimatedScene_Click"
                                            Tag="{x:Bind}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="16">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit" Click="EditScene_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Add to Room" Click="PinToRoom_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE718;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Delete" Click="DeleteScene_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <controls:AnimatedPreviewControl Scene="{x:Bind}"
                                                                                 Width="80" Height="40"
                                                                                 HorizontalAlignment="Left"/>
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Click="EditScene_Click"
                                                    Tag="{x:Bind}"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTipService.ToolTip="Edit scene">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Hue Effects Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Hue Effects"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <!-- Fixed 2-column grid populated from code-behind for stable layout -->
                    <Grid x:Name="HueEffectsGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>

                <!-- Preset Scenes Section (Built-In) -->
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Preset Scenes"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <HyperlinkButton Grid.Column="1"
                                         Content="Browse All"
                                         Click="BrowseAnimatedScenes_Click"/>
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.PresetScenes, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinItemHeight="100"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AnimatedSceneModel">
                                <Button Click="AnimatedScene_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="16">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Add to Room" Click="PinToRoom_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE718;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Spacing="8">
                                        <controls:AnimatedPreviewControl Scene="{x:Bind}"
                                                                         Width="80" Height="40"
                                                                         HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
