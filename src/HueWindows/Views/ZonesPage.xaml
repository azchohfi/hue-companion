<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.ZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:controls="using:HueWindows.Controls"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Zones"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading..."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Zone Cards -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind InvertBool(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Padding="36,0,36,36">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ZoneCards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="200"
                                           MinItemHeight="120"
                                           MinRowSpacing="12"
                                           MinColumnSpacing="12"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomCardViewModel">
                            <controls:RoomCard DataContext="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.HasZones), Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="360">

            <FontIcon Glyph="&#xE8F1;"
                      Style="{StaticResource EmptyStateIconStyle}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="No zones found"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Zones let you group lights across different rooms. For example, create a 'Downstairs' zone to control all ground floor lights together."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="Open Hue App"
                        Click="OpenHueApp_Click"/>
                <Button Content="Refresh"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"/>
            </StackPanel>

            <HyperlinkButton Content="Learn about zones"
                             NavigateUri="https://www.philips-hue.com/en-us/explore-hue/how-to/create-zones"
                             HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
