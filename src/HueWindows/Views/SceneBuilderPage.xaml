<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.SceneBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,24,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="BackButton_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Margin="0,0,16,0">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Scene Builder"
                       Style="{StaticResource PageHeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Save"
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar: Scene Name, Duration, Room -->
        <Grid Grid.Row="1" Padding="36,0,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Scene Name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                <TextBlock Text="Scene:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SceneNameTextBox"
                         Text="{x:Bind ViewModel.SceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Untitled Scene"
                         MinWidth="200"/>
            </StackPanel>

            <!-- Duration -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                <TextBlock Text="Duration:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <NumberBox x:Name="DurationNumberBox"
                           Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="3600"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1"
                           LargeChange="10"
                           MinWidth="120"/>
                <TextBlock Text="sec"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Room Selector -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Room:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="RoomComboBox"
                          ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                          SelectionChanged="RoomComboBox_SelectionChanged"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a room"
                          MinWidth="180"/>
            </StackPanel>
        </Grid>

        <!-- Timeline Area -->
        <Grid Grid.Row="2" Padding="36,0,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Timeline -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Time Ruler -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="150,8,16,8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Canvas x:Name="TimeRulerCanvas" Height="20"/>
                    </Border>

                    <!-- Tracks Area -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="TracksGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Track Labels -->
                            <ItemsRepeater x:Name="TrackLabelsRepeater"
                                           Grid.Column="0"
                                           VerticalAlignment="Top"
                                           ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackViewModel">
                                        <Border Height="50"
                                                Padding="16,0"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,1,1">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Keyframe Canvas -->
                            <Canvas x:Name="KeyframeCanvas"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    PointerPressed="KeyframeCanvas_PointerPressed"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                x:Name="EmptyStatePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <FontIcon Glyph="&#xE8B1;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="Select a room to start editing"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Each light will get its own track on the timeline"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Side Panel (appears on keyframe selection) -->
            <Border x:Name="SidePanel"
                    Grid.Column="1"
                    Width="280"
                    Margin="16,0,0,0"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="KeyframeTimeText"
                                   Text="Keyframe @ 0.0s"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Button Grid.Column="1"
                                Click="CloseSidePanel_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Panel Content -->
                    <StackPanel Grid.Row="1" Spacing="20">
                        <!-- Color Picker -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Color"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ColorPicker x:Name="KeyframeColorPicker"
                                         ColorSpectrumShape="Ring"
                                         IsAlphaEnabled="False"
                                         IsHexInputVisible="True"
                                         IsMoreButtonVisible="False"
                                         ColorChanged="KeyframeColorPicker_ColorChanged"/>
                        </StackPanel>

                        <!-- Brightness Slider -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="BrightnessValueText"
                                           Grid.Column="1"
                                           Text="100%"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    ValueChanged="BrightnessSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- Transition Style -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Transition"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox x:Name="TransitionComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="TransitionComboBox_SelectionChanged">
                                <ComboBoxItem Content="Linear" Tag="Linear"/>
                                <ComboBoxItem Content="Ease In" Tag="EaseIn"/>
                                <ComboBoxItem Content="Ease Out" Tag="EaseOut"/>
                                <ComboBoxItem Content="Ease In-Out" Tag="EaseInOut" IsSelected="True"/>
                                <ComboBoxItem Content="Instant" Tag="Instant"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Panel Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Duplicate"
                                Click="DuplicateKeyframe_Click"/>
                        <Button Content="Delete"
                                Click="DeleteKeyframe_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: Transport Controls -->
        <Border Grid.Row="3"
                Padding="36,16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play/Stop -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PlayButton"
                            Click="PlayButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Play (Space)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PlayButtonIcon" Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock x:Name="PlayButtonText" Text="Play"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton"
                            Click="StopButton_Click"
                            ToolTipService.ToolTip="Stop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Add Keyframe -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="AddKeyframe_Click"
                            ToolTipService.ToolTip="Add keyframe to all tracks at playhead position">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add Keyframe"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Loop Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EE;" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Loop:"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="LoopToggle"
                                  IsOn="True"
                                  OnContent=""
                                  OffContent=""/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
