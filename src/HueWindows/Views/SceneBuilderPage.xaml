<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueWindows.Views.SceneBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HueWindows.Views"
    xmlns:vm="using:HueWindows.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,24,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="BackButton_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Margin="0,0,16,0">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Scene Builder"
                       Style="{StaticResource PageHeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <!-- Open (with flyout for Open Scene / Import) -->
                <DropDownButton Content="Open">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Open Scene..." Click="OpenScene_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Import from File..." Click="ImportFile_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="New Scene" Click="NewScene_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Save -->
                <Button Content="Save"
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>

                <!-- Export -->
                <Button Click="ExportFile_Click"
                        ToolTipService.ToolTip="Export to File">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>

                <!-- Copy JSON -->
                <Button Click="CopyJson_Click"
                        ToolTipService.ToolTip="Copy JSON to Clipboard"
                        Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar: Scene Name, Duration, Room -->
        <Grid Grid.Row="1" Padding="36,0,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Scene Name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                <TextBlock Text="Scene:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SceneNameTextBox"
                         Text="{x:Bind ViewModel.SceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Untitled Scene"
                         MinWidth="200"/>
            </StackPanel>

            <!-- Duration -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                <TextBlock Text="Duration:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <NumberBox x:Name="DurationNumberBox"
                           Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="3600"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1"
                           LargeChange="10"
                           MinWidth="120"
                           ValueChanged="DurationNumberBox_ValueChanged"/>
                <TextBlock Text="sec"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Room Selector -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Room:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="RoomComboBox"
                          ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                          SelectionChanged="RoomComboBox_SelectionChanged"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a room"
                          MinWidth="180"/>
            </StackPanel>
        </Grid>

        <!-- Timeline Area -->
        <Grid Grid.Row="2" Padding="36,0,36,0">
            <!-- Timeline -->
            <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Time Ruler -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="150,8,16,8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Canvas x:Name="TimeRulerCanvas" Height="20"
                                Background="Transparent"
                                PointerPressed="TimeRulerCanvas_PointerPressed"/>
                    </Border>

                    <!-- Tracks Area -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="TracksGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Track Labels (Light tracks + Event tracks) -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <!-- Light Track Labels -->
                                <ItemsRepeater x:Name="TrackLabelsRepeater"
                                               ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TrackViewModel">
                                            <Border Height="50"
                                                    Padding="16,0"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,1,1">
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!-- Event Track Labels -->
                                <ItemsRepeater x:Name="EventTrackLabelsRepeater"
                                               ItemsSource="{x:Bind ViewModel.EventTracks, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EventTrackViewModel">
                                            <Border Height="50"
                                                    Padding="16,0"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,1,1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14"/>
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Keyframe Canvas -->
                            <Canvas x:Name="KeyframeCanvas"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    PointerPressed="KeyframeCanvas_PointerPressed"
                                    PointerWheelChanged="KeyframeCanvas_PointerWheelChanged"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                x:Name="EmptyStatePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <FontIcon Glyph="&#xE8B1;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="Select a room to start editing"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Each light will get its own track on the timeline"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Keyframe Panel (overlay on keyframe selection) -->
            <Border x:Name="SidePanel"
                    Width="280"
                    MaxHeight="500"
                    Margin="0,0,16,16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel Spacing="16">
                        <!-- Panel Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeyframeTimeText"
                                       Text="Keyframe @ 0.0s"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Button Grid.Column="1"
                                    Click="CloseSidePanel_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- Color Picker -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Color"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ColorPicker x:Name="KeyframeColorPicker"
                                         ColorSpectrumShape="Ring"
                                         IsAlphaEnabled="False"
                                         IsHexInputVisible="False"
                                         IsMoreButtonVisible="False"
                                         ColorChanged="KeyframeColorPicker_ColorChanged"/>
                        </StackPanel>

                        <!-- Brightness Slider -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="BrightnessValueText"
                                           Grid.Column="1"
                                           Text="100%"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    ValueChanged="BrightnessSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- Transition Style -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Transition"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox x:Name="TransitionComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="TransitionComboBox_SelectionChanged">
                                <ComboBoxItem Content="Linear" Tag="Linear"/>
                                <ComboBoxItem Content="Ease In" Tag="EaseIn"/>
                                <ComboBoxItem Content="Ease Out" Tag="EaseOut"/>
                                <ComboBoxItem Content="Ease In-Out" Tag="EaseInOut" IsSelected="True"/>
                                <ComboBoxItem Content="Instant" Tag="Instant"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Panel Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Duplicate"
                                    Click="DuplicateKeyframe_Click"/>
                            <Button Content="Delete"
                                    Click="DeleteKeyframe_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Event Track Panel (overlay on event track selection) -->
            <Border x:Name="EventSidePanel"
                    Width="280"
                    Margin="0,0,16,16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Padding="16" Spacing="16">
                    <!-- Panel Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="EventTrackIcon" Glyph="&#xE945;" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="EventTrackNameText"
                                   Grid.Column="1"
                                   Text="Lightning Flash"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Button Grid.Column="2"
                                Click="CloseEventSidePanel_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Effect Preset -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Effect"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <ComboBox x:Name="EventPresetComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="EventPresetComboBox_SelectionChanged">
                            <ComboBoxItem Content="Lightning Flash" Tag="LightningFlash"/>
                            <ComboBoxItem Content="Sparkle" Tag="Sparkle"/>
                            <ComboBoxItem Content="Candle Flicker" Tag="CandleFlicker"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Frequency Slider -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frequency"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="FrequencyValueText"
                                       Grid.Column="1"
                                       Text="Medium"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rare" Grid.Column="0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="FrequencySlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.1"
                                    Value="0.5"
                                    Margin="8,0"
                                    ValueChanged="FrequencySlider_ValueChanged"/>
                            <TextBlock Text="Frequent" Grid.Column="2"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Delete Button -->
                    <Button Content="Delete Event Track"
                            Click="DeleteEventTrack_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: Transport Controls (Two Rows) -->
        <Border Grid.Row="3"
                Padding="36,12,36,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Transport (Play/Stop, Time Display, Zoom) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Play/Stop -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PlayButton"
                                Click="PlayButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Play (Space)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="PlayButtonIcon" Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Name="PlayButtonText" Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton"
                                Click="StopButton_Click"
                                ToolTipService.ToolTip="Stop">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                <TextBlock Text="Stop"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Time Display (center) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="CurrentTimeText"
                                   Text="00:00.00"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="/"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalTimeText"
                                   Text="00:16.00"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Zoom Slider (right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71E;" FontSize="14" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Zoom Out"/>
                        <Slider x:Name="ZoomSlider"
                                Minimum="20"
                                Maximum="200"
                                Value="{x:Bind ViewModel.ZoomLevel, Mode=TwoWay}"
                                Width="120"
                                VerticalAlignment="Center"
                                ValueChanged="ZoomSlider_ValueChanged"
                                ToolTipService.ToolTip="Timeline Zoom"/>
                        <FontIcon Glyph="&#xE8A3;" FontSize="14" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Zoom In"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Tools (Add Keyframe/Event, Snap/Loop, Save) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add Keyframe / Add Event (left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Click="AddKeyframe_Click"
                                ToolTipService.ToolTip="Add keyframe to all tracks at playhead position">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="Add Keyframe"/>
                            </StackPanel>
                        </Button>

                        <Button ToolTipService.ToolTip="Add event track (lightning, sparkles, etc.)">
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="Lightning Flash" Click="AddLightningTrack_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE945;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Sparkle" Click="AddSparkleTrack_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE734;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Candle Flicker" Click="AddCandleTrack_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E8;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="14"/>
                                <TextBlock Text="Add Event"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Snap and Loop Toggles (center) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                        <!-- Snap Toggle -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE80A;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Snap:"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="SnapToggle"
                                          IsOn="{x:Bind ViewModel.IsSnapEnabled, Mode=TwoWay}"
                                          Toggled="SnapToggle_Toggled"
                                          OnContent=""
                                          OffContent=""
                                          ToolTipService.ToolTip="Snap to grid (hold Ctrl to temporarily disable)"/>
                        </StackPanel>

                        <!-- Loop Toggle -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Loop:"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="LoopToggle"
                                          IsOn="True"
                                          OnContent=""
                                          OffContent=""/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Save Button (right) -->
                    <Button Grid.Column="2"
                            Content="Save Scene"
                            Click="SaveButton_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
